{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-good-studio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "ai": {
    "binding": "AI",
  },
}
